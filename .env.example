# Copy to .env and fill unique deployment values. This file contains no credentials.
APP_BIND_IP=127.0.0.1
APP_PORT=8080

MYSQL_DATABASE=mental_health_assistant
MYSQL_USER=healthagent
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET=

# OpenAI-compatible Chat endpoint. Set all three values for the chosen provider.
AI_BASE_URL=https://api.deepseek.com
AI_COMPLETIONS_PATH=/chat/completions
AI_CHAT_MODEL=deepseek-flash
AI_API_KEY=

# Before enabling RAG, create the collection with docker compose run --rm qdrant-init.
RAG_ENABLED=false
RAG_VERSION=knowledge_v1
RAG_COLLECTION=healthagent_knowledge_v1
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_PATH=/embeddings
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_API_KEY=
